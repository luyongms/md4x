{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/md-to-pdf-hook.sh\"",
            "async": true,
            "timeout": 180,
            "statusMessage": "md4x: rendering doc PDF"
          }
        ]
      }
    ]
  }
}
